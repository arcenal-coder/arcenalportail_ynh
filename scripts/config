#!/bin/bash
source /usr/share/yunohost/helpers
ynh_abort_if_errors

install_dir=$(ynh_app_setting_get --key=install_dir)

get__gateway_url() {
    php -r '$c = require $argv[1]; echo $c["gateway_url"] ?? "";' "$install_dir/config.php"
}

get__gateway_key() {
    echo YNH_NULL
}

validate__gateway_url() {
    [[ "$gateway_url" =~ ^https://.+/custom/arcenalqsse/gateway\.php$ ]] || \
        echo "L’URL doit terminer par /custom/arcenalqsse/gateway.php."
}

validate__gateway_key() {
    [[ "$gateway_key" =~ ^[a-fA-F0-9]{64}$ ]] || \
        echo "La clé doit contenir exactement 64 caractères hexadécimaux."
}

write_gateway_config() {
    set +x
    if [[ -z "${gateway_url:-}" ]]; then
        gateway_url=$(php -r '$c = require $argv[1]; echo $c["gateway_url"] ?? "";' "$install_dir/config.php")
    fi
    if [[ -z "${gateway_key:-}" ]]; then
        gateway_key=$(php -r '$c = require $argv[1]; echo $c["gateway_key"] ?? "";' "$install_dir/config.php")
    fi
    [[ "$gateway_url" =~ ^https://.+/custom/arcenalqsse/gateway\.php$ ]] || ynh_die "URL de passerelle invalide."
    [[ "$gateway_key" =~ ^[a-fA-F0-9]{64}$ ]] || ynh_die "Clé de passerelle invalide."
    ynh_config_add --template="config.php" --destination="$install_dir/config.php"
    chmod 400 "$install_dir/config.php"
    chown "$app:www-data" "$install_dir/config.php"
}

set__gateway_url() {
    write_gateway_config
}

set__gateway_key() {
    write_gateway_config
}

ynh_app_config_run "$1"
