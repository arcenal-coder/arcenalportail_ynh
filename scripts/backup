#!/bin/bash
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers
php_runtime="${php_version:-${phpversion:-8.2}}"
# VACUUM INTO creates a consistent snapshot even while the app is used.
# Keep it until YunoHost has actually copied the paths declared by ynh_backup.
mkdir -p "$install_dir/.backup"
chmod 700 "$install_dir/.backup"
ARCENAL_PORTAL_CONFIG="$install_dir/config.php" \
    php"$php_runtime" "$install_dir/bin/manage.php" snapshot "$install_dir/.backup/vigilance.sqlite"
ynh_backup "$install_dir"
ynh_backup "$data_dir/logos"
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/php/$php_runtime/fpm/pool.d/$app.conf"
