#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers
ynh_script_progression "Mise à jour de VIGIlance..."
touch "$install_dir/.maintenance"
# Replace managed code without deleting configuration, data or historical files.
for directory in public src views migrations bin; do
    mkdir -p "$install_dir/$directory"
    cp -a "../sources/portal/$directory/." "$install_dir/$directory/"
done
chown -R "$app:www-data" "$install_dir"
vigilance_configure
ynh_config_add_phpfpm
ynh_config_add_nginx
rm -f "$install_dir/.maintenance"
ynh_script_progression "VIGIlance mis à jour."
