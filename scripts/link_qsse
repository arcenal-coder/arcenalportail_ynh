#!/bin/bash
set -euo pipefail

source /usr/share/yunohost/helpers

app="${1:-arcenalportail}"
gateway_url="${ARCENAL_GATEWAY_URL:-}"
gateway_key="${ARCENAL_GATEWAY_KEY:-}"

if [[ -z "$gateway_url" ]]; then
    read -r -p "URL HTTPS de la passerelle Dolibarr QSSE: " gateway_url
fi

if [[ -z "$gateway_key" ]]; then
    read -r -s -p "Cle de liaison QSSE (64 caracteres hexadecimaux): " gateway_key
    echo
fi

[[ "$gateway_url" =~ ^https://.+/custom/arcenalqsse/gateway\.php$ ]] || ynh_die "URL de passerelle invalide."
[[ "$gateway_key" =~ ^[a-fA-F0-9]{64}$ ]] || ynh_die "Cle de passerelle invalide."

install_dir=$(ynh_app_setting_get --app="$app" --key=install_dir)
[[ -n "$install_dir" ]] || ynh_die "Impossible de trouver le dossier d'installation pour $app."
[[ -d "$install_dir" ]] || ynh_die "Le dossier d'installation $install_dir n'existe pas."

tmp_config=$(mktemp)
php -r '
$url = $argv[1];
$key = $argv[2];
$target = $argv[3];
$content = "<?php\n"
    . "// Generated by ARCenal Portail link_qsse.\n"
    . "return [\n"
    . "    '\''trusted_sso'\'' => true,\n"
    . "    '\''gateway_url'\'' => " . var_export($url, true) . ",\n"
    . "    '\''gateway_key'\'' => " . var_export($key, true) . ",\n"
    . "];\n";
file_put_contents($target, $content);
' "$gateway_url" "$gateway_key" "$tmp_config"

install -o "$app" -g www-data -m 400 "$tmp_config" "$install_dir/config.php"
rm -f "$tmp_config"

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/_common.sh"
arcenal_configure_gateway_permission

ynh_print_info "Liaison QSSE enregistree pour $app."
